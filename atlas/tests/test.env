# Isolated compose project for tests/smoke.sh: own name, ports and volumes,
# so tests never touch the dev stack's data.
COMPOSE_PROJECT_NAME=atlas-test
VOCAB_DIR=./tests/fixtures/vocab-mini
POSTGRES_DB=ohdsi
POSTGRES_USER=ohdsi
POSTGRES_PASSWORD=test
WEBAPI_PORT=18080
ATLAS_PORT=18081
SOLR_PORT=18983
DB_PORT=15432
WEBAPI_PUBLIC_URL=http://localhost:18080/WebAPI/
ATLAS_INSTANCE_NAME="ATLAS test"
SOLR_HEAP=512m
PROXY_HTTP_PORT=18088
PROXY_HTTPS_PORT=18443
WORKSHOP_PASSWORD=test-pw
# Sourced by smoke.sh (set -a), so this empty value overrides an exported PGDATA_HOST_PATH.
# (Plain `docker compose --env-file` would NOT override a shell variable.)
PGDATA_HOST_PATH=
