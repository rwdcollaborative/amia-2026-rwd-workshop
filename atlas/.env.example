# Copy to .env and edit. .env is gitignored; never commit it.
COMPOSE_PROJECT_NAME=atlas

# Unzipped Athena vocabulary bundle (CONCEPT.csv, CONCEPT_ANCESTOR.csv, ...).
# Lives outside this repo. Absolute path, or relative to this directory.
# Can also be given on the command line: ./load-vocab.sh /path/to/bundle
VOCAB_DIR=

POSTGRES_DB=ohdsi
POSTGRES_USER=ohdsi
# Letters and digits only (it is embedded in SOLR_OPTS and parsed by both bash
# and compose), e.g. `openssl rand -hex 16`. Set it before the first start:
# Postgres keeps the password it was created with.
POSTGRES_PASSWORD=change-me

# Caddy (the "proxy" profile) is the way in: http://localhost/ locally, or
# http://<server-ip>/. It blocks WebAPI source admin and can require a shared
# password. Everything else listens on 127.0.0.1 only.
COMPOSE_PROFILES=proxy
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# Unset = no login prompt. Letters, digits and dashes only (this file is also
# read by bash). The username is WORKSHOP_USER (default "workshop").
#WORKSHOP_PASSWORD=
# :80 = plain HTTP on whatever IP the server has. For HTTPS without a domain,
# use <ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io.
#SITE_ADDRESS=:80

# The browser reaches WebAPI through Caddy, by this relative URL. Without the
# proxy, use http://<host>:8080/WebAPI/ and BIND_ADDR=0.0.0.0.
WEBAPI_PUBLIC_URL=/WebAPI/
ATLAS_INSTANCE_NAME="Workshop ATLAS"

# Direct host ports, for load-vocab.sh and debugging. DB and Solr are always
# bound to 127.0.0.1; WebAPI and ATLAS bind to BIND_ADDR.
BIND_ADDR=127.0.0.1
WEBAPI_PORT=8080
ATLAS_PORT=8081
SOLR_PORT=8983
DB_PORT=5432

# Where Postgres keeps its data: a named Docker volume by default. Set to a
# host path (e.g. on an external drive) for a full-vocabulary load.
#PGDATA_HOST_PATH=/Volumes/External/atlas-pgdata

# Solr JVM heap. 1g is fine for a vocab subset; use 2g+ for the full vocab.
SOLR_HEAP=1g
