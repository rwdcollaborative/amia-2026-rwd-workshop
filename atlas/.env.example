# Copy to .env and edit. .env is gitignored; never commit it.
COMPOSE_PROJECT_NAME=atlas

# Unzipped Athena vocabulary bundle (CONCEPT.csv, CONCEPT_ANCESTOR.csv, ...).
# Lives outside this repo. Absolute path, or relative to this directory.
# Can also be given on the command line: ./load-vocab.sh /path/to/bundle
VOCAB_DIR=

POSTGRES_DB=ohdsi
POSTGRES_USER=ohdsi
# Letters and digits only (it is embedded in SOLR_OPTS and parsed by both bash
# and compose), e.g. `openssl rand -hex 16`. Replace change-me before any
# server deploy.
POSTGRES_PASSWORD=change-me

# Host ports. DB and Solr are bound to 127.0.0.1 only.
# WebAPI and ATLAS bind to BIND_ADDR (default 0.0.0.0, all interfaces). Use
# 127.0.0.1 behind the proxy, or for local use on an untrusted network.
#BIND_ADDR=127.0.0.1
WEBAPI_PORT=8080
ATLAS_PORT=8081
SOLR_PORT=8983
DB_PORT=5432

# URL the *browser* uses to reach WebAPI. Behind the proxy use /WebAPI/.
WEBAPI_PUBLIC_URL=http://localhost:8080/WebAPI/
ATLAS_INSTANCE_NAME="Workshop ATLAS"

# Where Postgres keeps its data: a named Docker volume by default. Set to a
# host path (e.g. on an external drive) for a full-vocabulary load.
#PGDATA_HOST_PATH=/Volumes/External/atlas-pgdata

# Solr JVM heap. 1g is fine for a vocab subset; use 2g+ for the full vocab.
SOLR_HEAP=1g

# --- Server deploy (see README "Deploying to DigitalOcean") ---
# Caddy on ports 80/443: WebAPI source admin blocked, plus an optional shared
# password (leave WORKSHOP_PASSWORD unset for no login prompt).
# Also set BIND_ADDR=127.0.0.1 and WEBAPI_PUBLIC_URL=/WebAPI/ above.
#COMPOSE_PROFILES=proxy
#WORKSHOP_USER=workshop
# Letters, digits and dashes only (this file is also read by bash).
#WORKSHOP_PASSWORD=
# :80 = plain HTTP on whatever IP the droplet has. For HTTPS without a domain,
# use <ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io.
#SITE_ADDRESS=:80
